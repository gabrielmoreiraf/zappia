# ─────────────────────────────────────────────────────────────
# Zappia — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA comite .env.local.
# ─────────────────────────────────────────────────────────────

# Banco — Neon (Postgres serverless). Pegue a "pooled connection string"
# em https://console.neon.tech → seu projeto → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/zappia?sslmode=require"

# Auth.js — segredo para assinar sessões. Gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-forte"
# URL pública do app (em dev pode omitir; em produção use a URL da Vercel)
# AUTH_URL="https://seu-app.vercel.app"

# IA — Anthropic (Claude Haiku 4.5). https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Transcrição de áudio — Groq (Whisper Large v3 Turbo). https://console.groq.com
GROQ_API_KEY="gsk_..."

# WhatsApp Cloud API (Meta). https://developers.facebook.com
# Token permanente do app / system user
WHATSAPP_TOKEN="EAAG..."
# Phone Number ID do número (Meta) — usado para envios manuais do painel
WHATSAPP_PHONE_ID="1234567890"
# Token de verificação do webhook (você escolhe uma string; a Meta te devolve no handshake)
WHATSAPP_VERIFY_TOKEN="zappia-webhook-verify"
# App Secret (para validar a assinatura X-Hub-Signature-256 dos webhooks)
WHATSAPP_APP_SECRET="..."
# Embedded Signup (cliente conecta o próprio número pelo painel).
# Não são segredos — expostos ao navegador. Pegue em developers.facebook.com
# → seu app → Login do Facebook para Empresas → Configurações.
NEXT_PUBLIC_META_APP_ID="..."
NEXT_PUBLIC_META_WA_CONFIG_ID="..."

# E-mail — Resend (verificação de cadastro). https://resend.com
RESEND_API_KEY="re_..."
# Remetente. Precisa de domínio verificado no Resend; vazio = onboarding@resend.dev (teste)
EMAIL_FROM="Zappia <no-reply@seudominio.com.br>"

# Cron (resumo diário por e-mail). Bearer que a Vercel Cron envia. Gere: openssl rand -hex 24
CRON_SECRET="troque-por-um-segredo"

# Cobrança — Asaas (assinatura mensal do plano). https://www.asaas.com
# Chave de API: Asaas → Integrações → Gerar chave. A da sandbox e a de produção
# são diferentes; use a que combina com o ASAAS_ENV abaixo.
ASAAS_API_KEY="$aact_..."
# "sandbox" (padrão) ou "production". Qualquer outro valor cai em sandbox.
ASAAS_ENV="sandbox"
# Token do webhook: você escolhe a string e cadastra igual em
# Asaas → Integrações → Webhooks, campo "Token de autenticação". A Asaas manda
# ele no header asaas-access-token de cada evento; sem bater, o evento é
# recusado com 401. URL do webhook: https://seu-app.vercel.app/api/webhook/asaas
# Eventos necessários: PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE,
# PAYMENT_REFUNDED, PAYMENT_DELETED e SUBSCRIPTION_INACTIVATED.
ASAAS_WEBHOOK_TOKEN="troque-por-um-segredo"
